{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-chat",
  "tui": {
    "sidebar": "show",
    "scroll_speed": 3,
    "scroll_acceleration": {
      "enabled": true
    },
    "diff_style": "auto"
  },
  "instructions": [
    "SYSTEM.md",
    "MODELS.md",
    ".ai/PROJECT_KNOWLEDGE.md"
  ],
  "provider": {
    "zai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Z.AI (Zhipu GLM)",
      "options": {
        "baseURL": "https://api.z.ai/api/coding/paas/v4/"
      },
      "models": {
        "glm-4.6": {
          "name": "GLM-4.6",
          "limit": {
            "context": 200000,
            "output": 16000
          }
        },
        "glm-4.7": {
          "name": "GLM-4.7",
          "limit": {
            "context": 256000,
            "output": 32000
          }
        }
      }
    },
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek",
      "options": {
        "baseURL": "https://api.deepseek.com/v1"
      },
      "models": {
        "deepseek-chat": {
          "name": "DeepSeek V3.2",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "deepseek-reasoner": {
          "name": "DeepSeek V3.2 Thinking",
          "limit": {
            "context": 128000,
            "output": 64000
          }
        }
      }
    },
    "openai": {
      "npm": "@ai-sdk/openai",
      "name": "OpenAI",
      "models": {
        "gpt-5.2": {
          "name": "GPT-5.2 Thinking",
          "limit": {
            "context": 400000,
            "output": 128000
          }
        },
        "gpt-5.1": {
          "name": "GPT-5.1",
          "limit": {
            "context": 400000,
            "output": 128000
          }
        },
        "gpt-5.1-codex": {
          "name": "GPT-5.1 Codex",
          "limit": {
            "context": 200000,
            "output": 32000
          }
        }
      }
    },
    "google": {
      "npm": "@ai-sdk/google",
      "name": "Google",
      "models": {
        "gemini-3-flash-preview": {
          "name": "Gemini 3 Flash",
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        },
        "gemini-3-pro-preview": {
          "name": "Gemini 3 Pro",
          "limit": {
            "context": 1000000,
            "output": 64000
          }
        }
      }
    },
    "anthropic": {
      "npm": "@ai-sdk/anthropic",
      "name": "Anthropic",
      "models": {
        "claude-sonnet-4-5-20250514": {
          "name": "Claude Sonnet 4.5",
          "limit": {
            "context": 200000,
            "output": 64000
          }
        },
        "claude-haiku-4-5-20250514": {
          "name": "Claude Haiku 4.5",
          "limit": {
            "context": 200000,
            "output": 64000
          }
        },
        "claude-opus-4-5-20250514": {
          "name": "Claude Opus 4.5",
          "limit": {
            "context": 200000,
            "output": 64000
          }
        }
      }
    },
    "groq": {
      "npm": "@ai-sdk/groq",
      "name": "Groq",
      "models": {
        "llama-3.3-70b-versatile": {
          "name": "Llama 3.3 70B",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        },
        "llama-3.1-8b-instant": {
          "name": "Llama 3.1 8B Instant",
          "limit": {
            "context": 131072,
            "output": 8000
