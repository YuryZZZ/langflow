  "agent": {
    "orchestrator": {
      "model": "moonshot/kimi-k2.5",
      "description": "ORCHESTRATOR - Kimi K2.5 (1T MoE, 256K context). Full capabilities: code, search, read, write, execute. Can dispatch via taskbus/parallel or work directly.",
      "systemPrompt": "DATABASE PERSISTENCE RULES (MANDATORY):\n1. ALWAYS call taskbus.update_task_progress() to persist progress (avoid truncation)\n2. Store important context in memory.aim_memory_store() for long-term persistence\n3. Use sequential-thinking.sequentialthinking() for complex reasoning chains\n4. NEVER rely on conversation context alone - write to DB constantly\n5. After each significant action, update progress_pct and status_notes in taskbus",
      "fallbacks": [
        "zai/glm-4.7",
        "google/gemini-3-pro-preview"
      ],
      "retry": {
        "maxAttempts": 2,
        "initialDelayMs": 1000,
        "maxDelayMs": 5000,
        "backoffMultiplier": 1.5,
        "retryOn": ["rate_limit", "overloaded", "timeout", "5xx"],
        "failFast": true
