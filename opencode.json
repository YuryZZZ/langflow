  "command": {
    "auto": {
      "template": "$ARGUMENTS\n\n10X PARALLEL MODE v9.5:\n\nSTEP 1 - CREATE RUN:\n  taskbus.create_run()\n\nSTEP 2 - DISPATCH (3 planners + 7 workers = 10 agents):\n  parallel.parallel_dispatch_planners(task_description='$ARGUMENTS')\n  parallel.parallel_dispatch_workers(planner='orchestrator', task_description='$ARGUMENTS')\n\nSTEP 3 - PARALLEL EXECUTION:\n  - 3 PLANNERS: planner-1(Gemini), planner-2(Kimi), planner-3(GLM)\n  - 7 WORKERS: coder, coder-fast, coder-glm, coder-deep, validator, reviewer, tester\n  - YOU (orchestrator): Coordinate and work directly\n\nSTEP 4 - CROSS-VALIDATION:\n  - Results validated by different provider\n  - Best solution merged\n\nRULES:\n  - 10 parallel agents for 10x speed\n  - Write progress to taskbus and memory MCP\n  - Auto-cleanup on exit (no orphan processes)",
      "description": "10x parallel mode - 10 agents for maximum speed",
      "agent": "orchestrator"
    },
    "fast": {
      "template": "$ARGUMENTS\n\nFAST PARALLEL MODE:\n1. parallel.parallel_dispatch_workers() - dispatch 5 coders immediately\n2. Work directly while coders execute\n3. Cross-validate with different provider\n4. Merge best results",
      "description": "Fast execution - skip planner using PostgreSQL TaskBus",
      "agent": "orchestrator"
    },
    "debug": {
      "template": "$ARGUMENTS\n\nDEBUG MODE:\n1. Call sequential-thinking.sequentialthinking() for chain-of-thought\n2. Dispatch to @debugger (Z.AI GLM-4.7)\n3. Deep root cause analysis\n4. Return findings and fix recommendations",
      "description": "Deep debugging with chain-of-thought",
      "agent": "debugger"
    },
    "route": {
      "template": "$ARGUMENTS\n\nROUTING ANALYSIS:\n1. Analyze task complexity (1-10 scale)\n2. Check taskbus.get_recommended_coder(complexity)\n3. Return recommended: coder, validator, escalation path",
      "description": "Get complexity score and optimal routing",
      "agent": "orchestrator"
    },
    "plan": {
      "template": "$ARGUMENTS\n\nPLAN ONLY (no execution):\n1. taskbus.create_run()\n2. parallel.parallel_dispatch_planners() - planners auto-execute\n3. taskbus.get_run_status() - check progress\n4. Synthesize proposals into master plan\n5. Return plan for user approval",
      "description": "Create parallel architectural plan without executing",
      "agent": "orchestrator"
    },
    "swarm": {
      "template": "$ARGUMENTS\n\nPARALLEL SWARM MODE - 10 AGENTS:\n\n1. DISPATCH:\n   taskbus.create_run()\n   parallel.parallel_dispatch_planners('$ARGUMENTS')  // 3 planners\n   parallel.parallel_dispatch_workers('orchestrator', '$ARGUMENTS')  // 7 workers\n\n2. AGENTS:\n   PLANNERS (3): Gemini Pro, Kimi K2.5, GLM-4.7\n   WORKERS (7): coder, coder-fast, coder-glm, coder-deep, validator, reviewer, tester\n   ORCHESTRATOR: You - coordinate\n\n3. CROSS-VALIDATION:\n   - Results checked by different provider\n   - Best code merged\n\nTARGET: 10x speed with auto-cleanup on exit",
      "description": "Parallel swarm - 10 agents for 10x speed",
      "agent": "orchestrator"
    },
    "stop": {
      "template": "SHUTDOWN SEQUENCE:\n1. Call context-compactor.context_compact_now() to save conversation\n2. Notify user: 'Context saved. Run stop.bat in terminal to terminate all processes.'\n3. DO NOT execute any more tasks after this command.",
      "description": "Save context and prepare for shutdown (any active agent)"
    },
    "compact": {
      "template": "COMPACT CONTEXT NOW:\n1. Call context-compactor.context_compact_now() to compress conversation history\n2. Call context-compactor.context_get_stats() to show new utilization\n3. Report: 'Context compacted. New utilization: X%'",
      "description": "Force context compaction to free space",
      "agent": "orchestrator"
    }
  },
