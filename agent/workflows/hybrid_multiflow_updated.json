    { "source": "coder_fast", "target": "memory_component", "type": "writes" },
    { "source": "coder_primary", "target": "memory_component", "type": "writes" },
    { "source": "coder_glm", "target": "memory_component", "type": "writes" },
    { "source": "coder_deepseek", "target": "memory_component", "type": "writes" },
    { "source": "tester", "target": "memory_component", "type": "writes" },
    { "source": "reviewer", "target": "memory_component", "type": "writes" },
    { "source": "security", "target": "memory_component", "type": "writes" },
    { "source": "researcher", "target": "memory_component", "type": "writes" },
    { "source": "analyst", "target": "memory_component", "type": "writes" },
    { "source": "memory_component", "target": "validator_google", "type": "reads" },
    { "source": "memory_component", "target": "validator_anthropic", "type": "reads" },
    { "source": "validator_google", "target": "output_aggregator", "type": "validates" },
    { "source": "validator_anthropic", "target": "output_aggregator", "type": "validates" },
    { "source": "memory_component", "target": "output_aggregator", "type": "aggregates" }
