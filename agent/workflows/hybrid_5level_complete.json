  "edges": [
    "=== LEVEL 1: ORCHESTRATION ===",
    { "source": "orchestrator", "target": "planner_1", "type": "dispatches_to", "layer_transition": "1→2" },
    { "source": "orchestrator", "target": "planner_2", "type": "dispatches_to", "layer_transition": "1→2" },
    { "source": "orchestrator", "target": "planner_3", "type": "dispatches_to", "layer_transition": "1→2" },
    { "source": "orchestrator", "target": "planner_4", "type": "dispatches_to", "layer_transition": "1→2" },
    { "source": "orchestrator", "target": "planner_5", "type": "dispatches_to", "layer_transition": "1→2" },

    "=== LEVEL 2: PARALLEL PLANNING → LEVEL 3: SEQUENTIAL DESIGN ===",
    { "source": "planner_1", "target": "designer_architecture", "type": "provides_architecture_context" },
    { "source": "planner_2", "target": "designer_architecture", "type": "provides_security_requirements" },
    { "source": "planner_3", "target": "designer_architecture", "type": "provides_workflow_requirements" },
    { "source": "planner_4", "target": "designer_architecture", "type": "provides_logic_requirements" },
    { "source": "planner_5", "target": "designer_architecture", "type": "provides_implementation_context" },

    { "source": "designer_architecture", "target": "designer_components", "type": "feeds_to", "layer_transition": "2→3" },
    { "source": "designer_components", "target": "designer_interface", "type": "feeds_to", "layer_transition": "3→3" },
    { "source": "designer_interface", "target": "designer_data", "type": "feeds_to", "layer_transition": "3→3" },

    "=== LEVEL 3: SEQUENTIAL DESIGN → LEVEL 4: PARALLEL IMPLEMENTATION ===",
    { "source": "designer_data", "target": "coder_backend", "type": "provides_specification", "layer_transition": "3→4" },
    { "source": "designer_data", "target": "coder_frontend", "type": "provides_specification", "layer_transition": "3→4" },
    { "source": "designer_data", "target": "coder_database", "type": "provides_specification", "layer_transition": "3→4" },
    { "source": "designer_data", "target": "coder_security", "type": "provides_specification", "layer_transition": "3→4" },
    { "source": "designer_data", "target": "coder_fast", "type": "provides_specification", "layer_transition": "3→4" },
    { "source": "designer_data", "target": "coder_integration", "type": "provides_specification", "layer_transition": "3→4" },

    "=== LEVEL 4: PARALLEL IMPLEMENTATION → LEVEL 5: SEQUENTIAL REVIEW ===",
    { "source": "coder_backend", "target": "reviewer_code", "type": "submits_for_review", "layer_transition": "4→5" },
    { "source": "coder_frontend", "target": "reviewer_code", "type": "submits_for_review", "layer_transition": "4→5" },
    { "source": "coder_database", "target": "reviewer_code", "type": "submits_for_review", "layer_transition": "4→5" },
    { "source": "coder_security", "target": "reviewer_code", "type": "submits_for_review", "layer_transition": "4→5" },
    { "source": "coder_fast", "target": "reviewer_code", "type": "submits_for_review", "layer_transition": "4→5" },
    { "source": "coder_integration", "target": "reviewer_code", "type": "submits_for_review", "layer_transition": "4→5" },

    { "source": "reviewer_code", "target": "reviewer_security", "type": "feeds_to", "layer_transition": "5→5" },
    { "source": "reviewer_security", "target": "tester", "type": "feeds_to", "layer_transition": "5→5" },
    { "source": "tester", "target": "documenter", "type": "feeds_to", "layer_transition": "5→5" },

    "=== LEVEL 5: SEQUENTIAL REVIEW → LEVEL 6: PARALLEL VALIDATION ===",
    { "source": "documenter", "target": "validator_google", "type": "submits_for_validation", "layer_transition": "5→6" },
    { "source": "documenter", "target": "validator_anthropic", "type": "submits_for_validation", "layer_transition": "5→6" },

    "=== RESEARCH SUPPORT (Parallel to all layers) ===",
    { "source": "orchestrator", "target": "researcher", "type": "requests_research" },
    { "source": "planner_1", "target": "researcher", "type": "requests_current_best_practices" },
    { "source": "designer_architecture", "target": "researcher", "type": "requests_architecture_patterns" },
    { "source": "analyst", "target": "planner_1", "type": "provides_analysis", "bidirectional": true },
    { "source": "analyst", "target": "designer_data", "type": "provides_data_insights", "bidirectional": true },

    "=== MEMORY HUB (All agents write to memory) ===",
    { "source": "planner_1", "target": "memory_hub", "type": "writes_to_memory" },
    { "source": "planner_2", "target": "memory_hub", "type": "writes_to_memory" },
    { "source": "planner_3", "target": "memory_hub", "type": "writes_to_memory" },
