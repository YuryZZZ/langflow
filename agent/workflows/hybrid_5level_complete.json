    { "source": "designer_interface", "target": "memory_hub", "type": "writes_to_memory" },
    { "source": "designer_data", "target": "memory_hub", "type": "writes_to_memory" },
    { "source": "coder_backend", "target": "memory_hub", "type": "writes_to_memory" },
    { "source": "coder_frontend", "target": "memory_hub", "type": "writes_to_memory" },
    { "source": "coder_database", "target": "memory_hub", "type": "writes_to_memory" },
    { "source": "coder_security", "target": "memory_hub", "type": "writes_to_memory" },
    { "source": "coder_fast", "target": "memory_hub", "type": "writes_to_memory" },
    { "source": "coder_integration", "target": "memory_hub", "type": "writes_to_memory" },
    { "source": "reviewer_code", "target": "memory_hub", "type": "writes_to_memory" },
    { "source": "reviewer_security", "target": "memory_hub", "type": "writes_to_memory" },
    { "source": "tester", "target": "memory_hub", "type": "writes_to_memory" },
    { "source": "documenter", "target": "memory_hub", "type": "writes_to_memory" },
    { "source": "validator_google", "target": "memory_hub", "type": "writes_to_memory" },
    { "source": "validator_anthropic", "target": "memory_hub", "type": "writes_to_memory" },
    { "source": "researcher", "target": "memory_hub", "type": "writes_to_memory" },
    { "source": "analyst", "target": "memory_hub", "type": "writes_to_memory" },

    "=== AGGREGATION ===",
    { "source": "validator_google", "target": "output_aggregator", "type": "provides_validated_output" },
    { "source": "validator_anthropic", "target": "output_aggregator", "type": "provides_validated_output" },
    { "source": "memory_hub", "target": "output_aggregator", "type": "provides_all_outputs" },
    { "source": "output_aggregator", "target": "orchestrator", "type": "reports_completion" }
  ],

  "execution_config": {
    "mode": "hybrid_5level",
    "parallel_groups": ["planners", "coders", "validators"],
    "sequential_chains": [
      ["designer_architecture", "designer_components", "designer_interface", "designer_data"],
      ["reviewer_code", "reviewer_security", "tester", "documenter"]
    ],
    "max_parallel_per_group": 6,
    "sequential_timeout": 1800,
    "parallel_timeout": 900,
    "cross_validation": true,
    "mcp_memory_sync": true,
    "layer_progress_tracking": true
  },

  "layer_execution": {
    "layer_1_orchestration": {
      "mode": "sequential",
      "agents": ["orchestrator"],
      "output": "Task decomposition & coordination"
    },
    "layer_2_planning": {
      "mode": "parallel",
      "agents": ["planner_1", "planner_2", "planner_3", "planner_4", "planner_5"],
      "concurrent": true,
      "output": "5 parallel plans (architecture, security, workflow, logic, implementation)"
    },
    "layer_3_design": {
      "mode": "sequential",
      "agents": ["designer_architecture", "designer_components", "designer_interface", "designer_data"],
      "chain": true,
      "output": "Complete design specifications"
    },
    "layer_4_implementation": {
      "mode": "parallel",
      "agents": ["coder_backend", "coder_frontend", "coder_database", "coder_security", "coder_fast", "coder_integration"],
      "concurrent": true,
      "output": "6 parallel code implementations"
    },
    "layer_5_review": {
      "mode": "sequential",
      "agents": ["reviewer_code", "reviewer_security", "tester", "documenter"],
      "chain": true,
      "output": "Reviewed, tested, documented code"
    },
    "layer_6_validation": {
      "mode": "parallel",
      "agents": ["validator_google", "validator_anthropic"],
      "concurrent": true,
      "output": "Cross-model validated results"
    }
  }
}