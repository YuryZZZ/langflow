{
  "name": "Hybrid 5-Level Multi-Agent System - Complete",
  "description": "Full 5-layer hybrid architecture: Parallel Planning → Sequential Design → Parallel Implementation → Sequential Review → Parallel Validation",
  "version": "9.5.1",
  "created": "2026-02-02",
  "architecture": "5-Level Hybrid (Parallel + Sequential)",
  "layers": [
    {
      "level": 1,
      "name": "Orchestration Layer",
      "type": "control",
      "mode": "sequential",
      "description": "Master orchestrator controls entire flow"
    },
    {
      "level": 2,
      "name": "Parallel Planning Layer",
      "type": "parallel",
      "mode": "parallel",
      "agents": 5,
      "description": "5 planners work in parallel on different aspects"
    },
    {
      "level": 3,
      "name": "Sequential Design Layer",
      "type": "sequential",
      "mode": "sequential",
      "agents": 4,
      "description": "Architecture → Components → Interface → Data Model"
    },
    {
      "level": 4,
      "name": "Parallel Implementation Layer",
      "type": "parallel",
      "mode": "parallel",
      "agents": 6,
      "description": "6 coders implement in parallel"
    },
    {
      "level": 5,
      "name": "Sequential Review Layer",
      "type": "sequential",
      "mode": "sequential",
      "agents": 4,
      "description": "Code Review → Security → Testing → Documentation"
    },
    {
      "level": 6,
      "name": "Parallel Validation Layer",
      "type": "parallel",
      "mode": "parallel",
      "agents": 2,
      "description": "Cross-model validation by different providers"
    }
  ],
  "components": [
